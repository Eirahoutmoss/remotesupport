	state.mu.Unlock()

	c, err := clientsignaling.Dial(ctx, signalingEndpoint())
	if err != nil {
		setStatus("● Sunucuya bağlanılamadı: " + err.Error())
		return
	}

	code, expires, err := c.Create(ctx)
	if err != nil {
		_ = c.Close(context.Background())
		setStatus("● Kod oluşturulamadı: " + err.Error())
		return
	}

