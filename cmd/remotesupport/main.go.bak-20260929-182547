func wndProc(hwnd uintptr, m uint32, wParam, lParam uintptr) uintptr {
	switch m {
	case 0x0014: // WM_ERASEBKGND
		return 1
	case 0x0002: // WM_DESTROY
		stopSession()
		postQuit.Call(0)
		return 0
	case 0x0138: // WM_CTLCOLORSTATIC
		hdc := wParam
		setTextColor.Call(hdc, uintptr(uiTextColor))
		setBkMode.Call(hdc, 1) // TRANSPARENT
		return uiBgBrush
	case 0x0133: // WM_CTLCOLOREDIT
		hdc := wParam
		setTextColor.Call(hdc, uintptr(0x00151A24))
		setBkMode.Call(hdc, 2) // OPAQUE
		return uiEditBrush
	case 0x0135: // WM_CTLCOLORBTN
		hdc := wParam
		setTextColor.Call(hdc, uintptr(uiTextColor))
		setBkMode.Call(hdc, 1)
		return uiPanelBrush
	case 0x002B: // WM_DRAWITEM
		dis := (*drawItemStruct)(unsafe.Pointer(lParam))
		if dis != nil && dis.CtlType == 4 { // ODT_BUTTON
			drawOwnerButton(dis)
			return 1
		}
		return 0
	case 0x0202: // WM_LBUTTONUP
		x := int(int16(lParam & 0xffff))
		y := int(int16((lParam >> 16) & 0xffff))
		if x >= 0 && x < 150 && y >= 86 {
			switch {
			case y >= 86 && y < 150:
				sidebarPage.Store(0)
				home()
				return 0
			case y >= 150 && y < 204:
				sidebarPage.Store(1)
				return 0
			case y >= 204 && y < 258:
				sidebarPage.Store(2)
				showSettings()
				return 0
			case y >= 258 && y < 322:
				sidebarPage.Store(3)
				showAbout()
				return 0
			}
		}
	case 0x0111: // WM_COMMAND
		onCommand(int(wParam & 0xffff))
		return 0
	case WM_APP_MONITORS:
		count := int(wParam)
		updateMonitorButtons(count)
		setStatus(fmt.Sprintf("● Uzak bilgisayarda %d monitör bulundu", count))
		return 0
	case 0x0005: // WM_SIZE
		layoutUI()
		resizeViewer()
		return 0
	case 0x000F: // WM_PAINT
		var ps paintStruct
		hdc, _, _ := beginPaint.Call(hwnd, uintptr(unsafe.Pointer(&ps)))
		if hdc != 0 {
			paintShell(hdc)
			endPaint.Call(hwnd, uintptr(unsafe.Pointer(&ps)))
		}
		return 0
	}
	r, _, _ := defWindowProc.Call(hwnd, uintptr(m), wParam, lParam)
	return r
}

func addComboItems(hwnd uintptr, items ...string) {
	for _, item := range items {
		sendMessage.Call(hwnd, 0x0143, 0, uintptr(unsafe.Pointer(utf16ptr(item))))
	}
}

func main() {
	runtime.LockOSThread()
	loadSettings()
	initUITheme()

	class := utf16ptr(windowClass)
	wc := wndclassex{
		CbSize:        uint32(unsafe.Sizeof(wndclassex{})),
		LpfnWndProc:   syscall.NewCallback(wndProc),
		HInstance:     moduleHandle(),
		HCursor:       func() uintptr { r, _, _ := loadCursor.Call(0, 32512); return r }(),
		HbrBackground: 0, // parent paints the background in WM_PAINT
		LpszClassName: class,
	}
	registerClass.Call(uintptr(unsafe.Pointer(&wc)))

	hwnd, _, _ := createWindow.Call(
		0,
		uintptr(unsafe.Pointer(class)),
		uintptr(unsafe.Pointer(utf16ptr(appTitle))),
		0x00CF0000|0x02000000, // WS_CLIPCHILDREN
		200, 120, windowWidth, windowHeight,
		0, 0, moduleHandle(), 0,
	)
	if hwnd == 0 {
		return
	}
	state.hwnd = hwnd
	registerViewerClass()
	createViewer(hwnd)
	hideViewer()

	state.header = createControl(hwnd, "STATIC", "Remote Support", 0x00000000, 40, 30, 650, 45, 0)
