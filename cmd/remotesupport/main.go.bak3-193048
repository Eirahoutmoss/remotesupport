func paintFooter(hdc uintptr, w, h int, connected bool) {
	footerY := h - footerH
	fillBand(hdc, 0, footerY, w, footerH, rgb(uiBarColor))
	fillBand(hdc, 0, footerY, w, 1, rgb(uiBorderColor))
